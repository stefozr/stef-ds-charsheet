{{! Abilities Tab }}
<section class="tab abilities cse-tab {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  {{> cseActionBar tabId="abilities"}}
  {{#each abilities as |abilityType|}}
  {{#if abilityType.showHeader}}
  <section class="cse-table" data-cse-section="abilities.{{@key}}">
    <header class="cse-table-header">
      <a class="cse-table-toggle" data-action="cseToggleSection">
        <i class="cse-chevron fa-solid fa-chevron-down" inert></i>
        <h3>{{abilityType.label}}</h3>
        <span class="cse-count">{{abilityType.abilities.length}}</span>
      </a>
    {{#if (eq @key "villain")}}
    <div class="cse-col cse-col-order">{{localize "DRAW_STEEL.Item.ability.Order"}}</div>
    {{else}}
    <div class="cse-col cse-col-cost">{{@root.abilityFields.resource.label}}</div>
    {{/if}}
    <div class="cse-col cse-col-distance">{{@root.abilityFields.distance.label}}</div>
    <div class="cse-col cse-col-target">{{@root.abilityFields.target.label}}</div>
      <div class="cse-col cse-col-controls">
      {{#if abilityType.showAdd}}
      <a class="createDoc" data-action="createDoc" data-document-class="Item" data-type="ability" data-render-sheet="true" data-system.type="{{@key}}" data-tooltip-text="{{localize "DRAW_STEEL.SHEET.Add" itemName=(localize "TYPES.Item.ability")}}">
        <i class="fa-solid fa-plus" inert></i>
      </a>
      {{/if}}
    </div>
    </header>
    <ol class="cse-rows">
      {{#each abilityType.abilities as |abilityContext|}}
      <li class="item ability draggable expandable-document cse-row" data-document-uuid="{{abilityContext.item.uuid}}">
        <div class="cse-row-main" data-action="cseToggleRow">
          <div class="cse-cell cse-cell-name">
            <span class="cse-item-img rollable {{disabled (not @root.owner)}}" data-action="useAbility" data-tooltip="DSCSE.Roll"><img src="{{abilityContext.item.img}}" alt="" loading="lazy"><i class="cse-use fa-solid fa-dice" inert></i></span>
            {{#if abilityContext.item.system.restricted}}
            <span class="cse-restricted" data-tooltip="DRAW_STEEL.Item.ability.Restricted"><i class="fa-solid fa-triangle-exclamation" inert></i></span>
            {{/if}}
            <div class="name">
              <div class="label">{{abilityContext.item.name}}</div>
              <div class="keywords">{{abilityContext.formattedLabels.keywords}}</div>
            </div>
          </div>
          {{#if (eq @../key "villain")}}
          <div class="cse-cell cse-col-order">{{abilityContext.order}}</div>
          {{else}}
          <div class="cse-cell cse-col-cost">
            {{#if abilityContext.item.system.resource}}
            <span class="cse-pill">{{abilityContext.item.system.resource}} {{@root.system.coreResource.name}}</span>
            {{/if}}
          </div>
          {{/if}}
          <div class="cse-cell cse-col-distance">{{abilityContext.formattedLabels.distance}}</div>
          <div class="cse-cell cse-col-target">{{abilityContext.formattedLabels.target}}</div>
          <div class="cse-cell cse-col-controls">
            <a class="fa-fw fa-solid fa-ellipsis-vertical" data-action="documentListContext"></a>
          </div>
        </div>
        <div class="document-description item-embed {{#if abilityContext.expanded}}expanded{{/if}}">
          {{#if abilityContext.expanded}}{{{abilityContext.embed.outerHTML}}}{{/if}}
        </div>
      </li>
      {{/each}}
    </ol>
  </section>
  {{/if}}
  {{/each}}
</section>
